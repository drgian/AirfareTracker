[Unit]
Description=FlightFare API
After=network.target postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/opt/flightfare/api
EnvironmentFile=/etc/flightfare/api.env
ExecStart=/opt/flightfare/api/venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
