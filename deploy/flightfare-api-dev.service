[Unit]
Description=FlightFare API (dev)
After=network.target postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/opt/flightfare/api-dev
EnvironmentFile=/etc/flightfare/api-dev.env
ExecStart=/opt/flightfare/api-dev/venv/bin/uvicorn api:app --host 127.0.0.1 --port 8001 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
