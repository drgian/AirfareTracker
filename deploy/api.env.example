# /etc/flightfare/api.env (live) and /etc/flightfare/api-dev.env (test copy): root:ubuntu, mode 640
DATABASE_URL=dbname=flighttracker          # flighttracker_dev for the test copy
APP_URL=https://flightfare.io/             # https://flightfare.io/dev/ for the test copy
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=<Resend API key>
MAIL_FROM=alerts@flightfare.io
GOOGLE_CLIENT_ID=<Google OAuth client ID>.apps.googleusercontent.com
PRIVATE_TO=you@example.com                # test copy only: comma-separated emails allowed in; leave unset on live
